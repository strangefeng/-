    "epochs": 100,
    "batch": 8,
    "device": "auto",
    "workers": 0,
    "seed": 42,
    "deterministic": true,
    "optimizer": "auto",
    "amp": true,
    "plots": true,
    "val": true,
    "save": true,
    "exist_ok": false,
    "rect": false,
    "cache": false,
    "pretrained": true,
    "mosaic": 0.0,
    "erasing": 0.0,
