{
  "suite_id": "aircraft_ai_uav_paper_ablation",
  "description": "Ablation and small-defect localization experiments on the cleaned UAV aircraft skin defect dataset.",
  "results_csv": "results/aircraft_ai_uav_paper_ablation.csv",
  "target_class_names": [
    "missing-rivet",
    "rust",
    "scratch"
  ],
  "dataset_yaml": "datasets/generated_3cls/aircraft_ai_uav_clean_split.yaml",
  "project": "runs/aircraft_ai_uav_paper_ablation",
