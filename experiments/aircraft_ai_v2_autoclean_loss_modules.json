{
  "suite_id": "aircraft_ai_v2_autoclean_loss_modules",
  "description": "Loss and assigner module ablation on the conservative auto-cleaned Aircraft AI v2 dataset.",
  "results_csv": "results/aircraft_ai_v2_autoclean_loss_modules.csv",
  "target_class_names": [
    "missing-rivet",
    "rust",
    "scratch"
  ],
  "dataset_yaml": "datasets/generated_3cls/aircraft_ai_v2_cleaneval_cleantrain.yaml",
  "project": "runs/aircraft_ai_v2_autoclean_loss_modules",
  "train_defaults": {
    "imgsz": 800,
    "epochs": 100,
    "batch": 12,
    "device": "auto",
    "workers": 0,
    "seed": 42,
    "deterministic": true,
    "optimizer": "auto",
    "amp": true,
    "plots": true,
    "val": true,
    "save": true,
    "exist_ok": false,
    "rect": false,
    "cache": false,
    "pretrained": true,
    "mosaic": 0.0,
    "erasing": 0.0,
    "mixup": 0.0,
    "auto_augment": "none",
    "flipud": 0.0,
    "close_mosaic": 0,
    "patience": 30
  },
  "metadata_defaults": {
    "experiment_group": "aircraft_ai_v2_autoclean_loss_modules",
    "dataset_id": "aircraft_ai_v2_autoclean",
    "dataset_role": "clean_train_clean_eval",
    "augment_profile": "n2_no_mosaic_no_erasing",
    "feature_variant": "default",
    "backbone_variant": "yolo11_default",
    "neck_variant": "default",
    "notes": "Keeps YOLO11n pretrained architecture fixed and changes only bbox loss or label assignment."
  },
  "experiments": [
    {
      "experiment_id": "L1_NWD_LOSS",
      "name": "L1_nwd_loss_clean_n2",
      "title": "NWD bbox loss on cleaned labels",
      "ready": true,
      "metadata": {
        "loss_variant": "nwd_loss",
        "assigner_variant": "default",
        "notes": "Adds normalized Gaussian Wasserstein distance to bbox regression for tiny defects."
      },
      "runtime": {
        "nwd_loss_ratio": 0.25,
        "nwd_constant": 12.8
      }
    },
    {
      "experiment_id": "L2_NWD_ASSIGNER",
      "name": "L2_nwd_assigner_clean_n2",
      "title": "NWD task-aligned assigner on cleaned labels",
      "ready": true,
      "metadata": {
        "loss_variant": "default",
        "assigner_variant": "nwd_assigner",
        "notes": "Uses NWD-aware assignment while preserving standard bbox loss."
      },
      "runtime": {
        "nwd_assigner_ratio": 0.25,
        "nwd_constant": 12.8
      }
    },
    {
      "experiment_id": "L3_FOCALER_IOU",
      "name": "L3_focaler_iou_clean_n2",
      "title": "Focaler-IoU bbox loss on cleaned labels",
      "ready": true,
      "metadata": {
        "loss_variant": "focaler_iou",
        "assigner_variant": "default",
        "notes": "Tests focused IoU regression under the cleaned-label N2 recipe."
      },
      "runtime": {
        "focaler_lower": 0.0,
        "focaler_upper": 0.95
      }
    }
  ]
}
